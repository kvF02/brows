{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allow every custom IPC command defined in the Brows desktop app.",
  "local": true,
  "remote": {
    "urls": ["http://127.0.0.1:4173/*"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-profile-list",
    "allow-profile-get",
    "allow-profile-create",
    "allow-profile-update",
    "allow-profile-clone",
    "allow-profile-archive",
    "allow-profile-restore",
    "allow-proxy-list",
    "allow-proxy-save",
    "allow-proxy-remove",
    "allow-proxy-test",
    "allow-diagnostic-run",
    "allow-diagnostic-list",
    "allow-legacy-migration-inspect",
    "allow-legacy-migration-execute",
    "allow-legacy-migration-rollback",
    "allow-legacy-migration-list",
    "allow-morelogin-preview",
    "allow-morelogin-import",
    "allow-fingerprint-preview",
    "allow-list-runtimes",
    "allow-session-launch",
    "allow-session-stop",
    "allow-session-cancel-queued",
    "allow-session-list",
    "allow-backup-list",
    "allow-backup-export"
  ]
}
