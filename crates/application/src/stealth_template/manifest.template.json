{
  "manifest_version": 3,
  "name": "Brows Stealth for {{profile_id}}",
  "version": "1.0.0",
  "description": "Generated stealth hooks for the SeedableNoise persona. Not a user-installed extension.",
  "permissions": [],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
