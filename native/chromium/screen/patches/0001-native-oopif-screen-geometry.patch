+  display::ScreenInfos infos = GetOriginalScreenInfos();
+  const display::ScreenInfo& exposed = GetScreenInfo();
+  display::ScreenInfo& current = infos.mutable_current();
+  current.rect = exposed.rect;
+  current.available_rect = exposed.available_rect;
+  current.orientation_type = exposed.orientation_type;
+  current.orientation_angle = exposed.orientation_angle;
+  return infos;
